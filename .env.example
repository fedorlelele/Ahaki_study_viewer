# Supabase (local_admin_app.py が参照)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Optional fallback name
SUPABASE_SERVICE_ROLE_KEY=

# Local admin defaults (optional)
AHAKI_ADMIN_DB=output/ahaki.sqlite
AHAKI_ADMIN_HOST=127.0.0.1
AHAKI_ADMIN_PORT=8001
AHAKI_ADMIN_SUBTOPICS=config/subtopics_catalog.json
AHAKI_ADMIN_PROMPT_SAMPLE=resources/custum_prompt_sample.txt
AHAKI_ADMIN_DOWNLOADS=/Users/yourname/Downloads

# Gemini keys (scripts 用)
GEMINI_API_KEY_FREE=
GEMINI_API_KEY_PAID=
GEMINI_API_KEY=
